---
interface Props {
  status: "prototype" | "stable" | "archived" | "preprint" | "conference" | "journal" | "in-progress" | "planned";
  size?: "sm" | "md";
}

const { status, size = "sm" } = Astro.props;

const map: Record<string, { label: string; tone: string }> = {
  prototype: { label: "Prototype", tone: "bg-amber-500/15 text-amber-700 border-amber-500/40" },
  stable: { label: "Stable", tone: "bg-emerald-500/15 text-emerald-700 border-emerald-500/40" },
  archived: { label: "Archived", tone: "bg-zinc-400/15 text-zinc-600 border-zinc-400/40" },
  preprint: { label: "Preprint", tone: "bg-amber-500/15 text-amber-700 border-amber-500/40" },
  conference: { label: "Conference", tone: "bg-sky-500/15 text-sky-700 border-sky-500/40" },
  journal: { label: "Journal", tone: "bg-emerald-500/15 text-emerald-700 border-emerald-500/40" },
  "in-progress": { label: "In progress", tone: "bg-blue-500/15 text-blue-700 border-blue-500/40" },
  planned: { label: "Planned", tone: "bg-zinc-400/15 text-zinc-600 border-zinc-400/40" },
};

const meta = map[status] ?? { label: status, tone: "bg-zinc-400/15 text-zinc-600 border-zinc-400/40" };
const sizing = size === "sm" ? "text-[10px] px-2 py-0.5" : "text-xs px-2.5 py-1";
---

<span
  class:list={[
    "inline-flex items-center gap-1 rounded-full border font-medium uppercase tracking-wider",
    meta.tone,
    sizing,
  ]}
>
  {meta.label}
</span>
